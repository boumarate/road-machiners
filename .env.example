# Integer seed for world generation and all sim randomness.
VITE_SEED=1337
# Projectile flight time, then time to read the volley results, in milliseconds.
VITE_COMBAT_SHOT_MS=320
VITE_COMBAT_READ_MS=1100
# Completed turns between automatic local saves.
VITE_SAVE_TURNS=20
# Hold delay separates a Space tap from fast-forward. Speed multiplies playback time.
VITE_TRAVEL_HOLD_MS=250
VITE_TRAVEL_FAST_SPEED=4
# Player start kit from src/data/start.ts: standard, or combat for testing fights.
VITE_START_KIT=standard
# Sound generation for scripts/sfx-gen.mjs only; never sent to the browser. Paid plans allow commercial use.
ELEVENLABS_API_KEY=
# Most ElevenLabs generations one sfx:gen run may make.
SFX_MAX_GENERATIONS=6
