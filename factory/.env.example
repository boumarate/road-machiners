# The game factory reads this file as factory/.env. See README.md. Every key is required when the factory runs.
# GitHub repo the factory works on, as "owner/name".
FACTORY_REPO=
# Owner and number of the GitHub Project that holds the kanban. Its Status field needs Design, Implementation, Testing, Approval and Done.
FACTORY_PROJECT_OWNER=
FACTORY_PROJECT_NUMBER=
# Folder for the host clone, work clones, logs, state and the inbox.
FACTORY_HOME=
# Folder the web server serves. Builds go to <root>/dev and <root>/<hash>.
FACTORY_WEB_ROOT=
# Address of that folder in a browser, without a trailing slash.
FACTORY_PUBLIC_URL=
# Docker image of the agent container, built from factory/docker.
FACTORY_IMAGE=roam-factory:dev
# Claude subscription token from `claude setup-token`. It is the only secret agent containers get.
CLAUDE_CODE_OAUTH_TOKEN=
# Models for the design stage and for all other agent work.
FACTORY_DESIGN_MODEL=claude-opus-5-5
FACTORY_BUILD_MODEL=claude-sonnet-5-5
# Thumbs-up votes that mark an issue for work, and how old in hours it must be first.
FACTORY_MIN_VOTES=
FACTORY_MIN_AGE_HOURS=
# The committee lives in $FACTORY_HOME/committee/committee.json and changes with /committee in the chat.
# Until that file exists, the committee is one member: this Telegram user id and GitHub login.
# One committee thumbs-up marks an issue.
FACTORY_COMMITTEE_BOOTSTRAP=
FACTORY_COMMITTEE_BOOTSTRAP_GITHUB=
# Telegram bot shared with Hermes, the committee chat id and the public channel id or @name.
TELEGRAM_BOT_TOKEN=
FACTORY_COMMITTEE_CHAT=
FACTORY_PUBLIC_CHANNEL=
# Minutes between ticks, and minutes a stage may run before the factory stops it.
FACTORY_TICK_MINUTES=
FACTORY_STAGE_TIMEOUT_MINUTES=
# Days between releases to itch.io, and hours between maintenance passes.
FACTORY_RELEASE_DAYS=
FACTORY_MAINTENANCE_HOURS=24
# itch.io page and butler key for releases, as in game/.env.example. The factory uploads the built game/dist with butler.
ITCH_TARGET=
BUTLER_API_KEY=
