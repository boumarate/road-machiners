# Copy to prod.env (gitignored) and fill in. Run pyinfra from factory/infra.

# Server address or DNS name.
FACTORY_HOST=
# SSH login. Deploy uses sudo, so a non-root user needs passwordless sudo.
FACTORY_SSH_USER=root
# Path to the private key for that login. Leave empty to use the ssh agent.
FACTORY_SSH_KEY=
# Public domain. It must point at the server before Caddy can get a certificate.
FACTORY_DOMAIN=
# Email for the ACME account. Let's Encrypt writes here about expiring certificates.
FACTORY_ACME_EMAIL=
# Local path of the factory .env that deploy pushes. It must set FACTORY_HOME=/opt/factory/home and FACTORY_WEB_ROOT=/opt/factory/www.
FACTORY_ENV_FILE=
# Classic GitHub token of the bot account, with repo and project scopes. Deploy writes it into the server's factory env as GH_TOKEN.
FACTORY_GH_TOKEN=
# Hetzner Cloud API token, read and write, for firewall.py only.
HCLOUD_TOKEN=
