{
	email {$ACME_EMAIL}
	servers {
		# HTTP/3 needs UDP 443, which the firewall does not open.
		protocols h1 h2
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# The web root holds /dev/ and one folder per build hash. Folder requests serve index.html.
# The bare domain sends players to the released game on itch.io. The builds stay under their paths.
{$DOMAIN} {
	import security_headers
	redir / {$ITCH_URL} temporary
	root * /srv/www
	file_server {
		index index.html
	}
}

# www sends every request to the bare domain, keeping the path.
www.{$DOMAIN} {
	import security_headers
	redir https://{$DOMAIN}{uri} permanent
}
