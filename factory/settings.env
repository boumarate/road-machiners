# Factory settings. Git tracks this file, and the server runs main's copy. Change a value through a pull request to main.
# Secrets, committee ids and host paths live in factory/.env, which never leaves its host. See .env.example. A key in both files stops the factory.
# GitHub repo the factory works on, as "owner/name".
FACTORY_REPO=btseytlin/road-machiners
# Owner and number of the GitHub Project that holds the kanban. Its Status field needs Triage, Design, Implementation, Testing, Approval and Done.
FACTORY_PROJECT_OWNER=btseytlin
FACTORY_PROJECT_NUMBER=2
# Docker image of the agent container, built from factory/docker.
FACTORY_IMAGE=roam-factory:dev
# Model ids. FACTORY_DESIGN_MODEL is the Opus id and FACTORY_BUILD_MODEL the Sonnet id. Issue labels pick one of them per stage, see README.md, section Model routing.
FACTORY_DESIGN_MODEL=claude-opus-5-5
FACTORY_BUILD_MODEL=claude-sonnet-5-5
# Thumbs-up votes that mark an issue for work, and how old in hours it must be first.
FACTORY_MIN_VOTES=1
FACTORY_MIN_AGE_HOURS=0.01
# The most ElevenLabs generations one sfx:gen run of an agent may make.
SFX_MAX_GENERATIONS=6
# Minutes between ticks. The tick timer takes it when the server is provisioned.
FACTORY_TICK_MINUTES=1
# Minutes a stage may run before the factory stops it.
FACTORY_STAGE_TIMEOUT_MINUTES=180
# Days between releases to itch.io.
FACTORY_RELEASE_DAYS=7
# Public agent jobs (triage, design, implement, testing, release cut) allowed in any 24 hours. Approve, change and ad hoc jobs do not count.
FACTORY_MAX_JOBS_PER_DAY=200
# Jobs that run at once, per queue. Triage, design and implementation each have their own queue, and ad hoc jobs run in the implementation queue. The test queue runs testing, which builds the game and plays it in a browser, so it needs the most memory. Branch jobs, like approve and ship, always run one at a time.
FACTORY_TRIAGE_WORKERS=1
FACTORY_DESIGN_WORKERS=1
FACTORY_IMPLEMENT_WORKERS=1
FACTORY_TEST_WORKERS=1
# Reasoning effort of the triage agent, passed to claude --effort. Triage only reads and judges, so low is enough.
FACTORY_TRIAGE_EFFORT=low
# Free disk in GB under which a tick starts no job, and Hermes gets a disk incident. A tick starts at most 5 jobs, each needs about 0.6 GB for its clone, packages and build, and an image rebuild needs room too.
FACTORY_MIN_FREE_GB=5
# Days a job log stays. Failures live a day and a release spans FACTORY_RELEASE_DAYS, so this keeps two releases of history.
FACTORY_LOG_DAYS=14
# Shares of the server's CPUs, as fractions that add up to 1 or less. Each pool gets round(share × cores) whole CPUs, at least 1, and its job containers are pinned to them. Jobs of one pool share its CPUs, and a pool never borrows from another, so the factory checks always get theirs.
# Triage, design and branch jobs mostly wait on the model or run short builds, so they share one pool.
FACTORY_CPU_LIGHT=0.25
# Implement and ad hoc jobs run targeted tests and one full test run.
FACTORY_CPU_IMPLEMENT=0.25
# Testing runs the full test suite, the typecheck and a browser playtest. Its tests time out when it gets fewer CPUs than this.
FACTORY_CPU_TEST=0.5
# itch.io page as "user/game". Only a release needs it, together with BUTLER_API_KEY in .env.
ITCH_TARGET=btseytlin/road-machiners
